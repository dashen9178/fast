# ===== 打包中间产物（每次构建都会重建，不需要纳入版本管理）=====
/stage/
/out/

# ===== 编辑器签名钥匙：刻意不纳入版本管理 =====
# keys/editor.p12 只用来签"编辑器本体"这一支，永远不会被打包进任何 APK。
# 它仍然是机密：泄露出去别人能签出假的"FAST 编辑器更新"。请单独备份（加密网盘等）。
#
# 注意：导出的作品已经不再使用这把钥匙 —— 改由每台设备首次运行时自己生成
# （见 src/com/doubao/blockbuilder/DeviceKey.java），所以编辑器 APK 可以随意分发。
/keys/

# ===== 系统/编辑器产生的杂物 =====
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.log

# ===== 2026-10-27 加：公开仓库禁止上传的东西 =====
# 部署目录里有明文密钥（s.yaml / clone 里的函数配置含 SMTP 授权码、SeaTable Token）。
# 完整值只留在本机与云函数环境变量里，仓库里一个都不能出现。
/fc-deploy/
/aliyun-fc-mail/s.yaml

# 依赖与缓存（体积大、可由 lock 文件重建）
node_modules/
/.wrangler/
__pycache__/
*.pyc

# 私钥 / 签名材料 / 产物
*.p12
*.pk8
*.jks
*.keystore
*.apk

# 临时/备份文件（*.bak_before_*, *.damaged, *.corrupt, *.new 等都是历史遗留）
*.bak_before_*
*.damaged
*.corrupt
*.fixed
*.new

